# Banco de dados (usado pelo Spring Boot e pelo Docker Compose)
DB_URL=jdbc:postgresql://localhost:5432/java_league
DB_USERNAME=postgres
DB_PASSWORD=change_me

# JWT - obrigatório, sem valor padrão
JWT_SECRET=change_me_to_a_long_random_secret

# pgAdmin (apenas Docker Compose)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me
